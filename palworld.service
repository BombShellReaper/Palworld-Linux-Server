[Unit]
Description=Palworld Server Instance
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=forking
User=your_username
WorkingDirectory=/home/your_username
ExecStart=/home/your_username/name/palworld.sh
RemainAfterExit=no
Restart=no
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
